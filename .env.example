# Copy to .env.local. Keep the backend URL server-only; NEXT_PUBLIC values are
# build-time configuration and must never contain secrets.
# Set an authorized local or staging API URL ending in /api/v1.
# Keep production out of this template to prevent accidental write-flow tests.
BACKEND_API_URL=
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only. Must match Laravel's BFF_SHARED_SECRET (at least 32 random bytes).
BFF_SHARED_SECRET=
# Set 4 on Vercel to leave room for multipart framing under its request-body limit.
NEXT_PUBLIC_LIBRARY_MAX_MB=20
